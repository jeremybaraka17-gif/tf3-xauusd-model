# Copy this file to ".env" (NOT this example file -- ".env" is what tf3_daemon.py
# actually reads) in this same "live" folder, and fill in your real values.
# ".env" holds secrets and account-identifying values -- never share it, paste it
# into a chat, or commit it anywhere public. Treat the bot token like a password:
# anyone who has it can post to your Telegram chat as your bot.

# From @BotFather on Telegram (/newbot). Looks like 123456789:ABCdefGhIJKlmnOPQRstuVWXyz
TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# From @userinfobot (message it directly), or the bot's own getUpdates response
# after you've messaged it once. A plain number for a personal chat, or a
# negative number for a group.
TELEGRAM_CHAT_ID=PASTE_YOUR_CHAT_ID_HERE

# The MT5 account number the terminal must be logged into. This is the
# fail-safe's input -- get this wrong and the daemon will (correctly) refuse
# to run against whatever account IS logged in, since it won't match.
EXPECTED_ACCOUNT_LOGIN=PASTE_YOUR_MT5_ACCOUNT_LOGIN_HERE

# The exact broker server string MT5 shows when logged in (e.g. "GFT-Live" or
# "GFT-Demo") -- must match character for character.
EXPECTED_ACCOUNT_SERVER=PASTE_YOUR_BROKER_SERVER_STRING_HERE
